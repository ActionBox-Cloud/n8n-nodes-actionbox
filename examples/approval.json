{
  "name": "ActionBox approval demo",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "request-approval",
      "name": "Request Approval",
      "type": "n8n-nodes-actionbox.actionBox",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "resource": "action",
        "operation": "requestApproval",
        "title": "Approve this demo operation",
        "description": "This example performs no external side effect.",
        "priority": "normal",
        "reviewerEmails": "",
        "approveLabel": "Approve",
        "rejectLabel": "Reject",
        "timeoutMinutes": 1440
      }
    },
    {
      "id": "approved",
      "name": "Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.actionbox.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "demo-operation",
      "name": "Demo Operation",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        -100
      ],
      "parameters": {}
    },
    {
      "id": "report-success",
      "name": "Report Success",
      "type": "n8n-nodes-actionbox.actionBox",
      "typeVersion": 1,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "resource": "action",
        "operation": "reportOutcome",
        "actionId": "={{ $json.actionbox.action_id }}",
        "outcomeStatus": "success",
        "actionVersion": "={{ $json.actionbox.action_version }}",
        "fingerprint": "={{ $json.actionbox.fingerprint }}"
      }
    },
    {
      "id": "not-approved",
      "name": "Not Approved",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        100
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Request Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Approval": {
      "main": [
        [
          {
            "node": "Approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved": {
      "main": [
        [
          {
            "node": "Demo Operation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Not Approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Demo Operation": {
      "main": [
        [
          {
            "node": "Report Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
